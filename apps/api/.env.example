# ═══════════════════════════════════════════════════════════════════
#  G-Music backend configuration
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8756
DATA_DIR=./data            # ที่เก็บไฟล์เสียง/งาน/เสียงที่โคลน

# ── Brain (สมอง LLM) ────────────────────────────────────────────────
# เลือกสมองหลัก: "ollama" (local) หรือ "cloud"
BRAIN_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cloud — เลือก provider: anthropic | openai | openrouter
CLOUD_PROVIDER=anthropic
CLOUD_API_KEY=
CLOUD_MODEL=claude-opus-4-8
# CLOUD_BASE_URL=          # เว้นว่างได้ ใช้ค่า default ของแต่ละ provider
                           # openrouter: https://openrouter.ai/api/v1

# ── Speech models ───────────────────────────────────────────────────
ASR_MODEL=large-v3         # faster-whisper: tiny|base|small|medium|large-v3
ASR_DEVICE=cuda            # cuda | cpu
ASR_COMPUTE_TYPE=float16   # float16 (GPU) | int8 (CPU)

TTS_ENGINE=f5              # f5 | xtts
TTS_DEVICE=cuda            # cuda | cpu
# โมเดลไทยของ F5-TTS (HuggingFace repo) — เว้นว่างเพื่อใช้ค่า default ในโค้ด
F5_MODEL_REPO=VIZINTZOR/F5-TTS-THAI
