{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "personal-youtube-decks",
  "description": "CR-010/CR-011 personal builds only: youtube.com deck and search pages may report player state, media keys and search results, nothing else",
  "webviews": ["deck-a", "deck-b", "deck-search"],
  "remote": { "urls": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*", "https://youtube.com/*"] },
  "permissions": ["allow-deck-report", "allow-deck-media-key", "allow-deck-search-report"]
}
