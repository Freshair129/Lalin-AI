{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lalin.local/schemas/w2-c-smart-medley-timing-v2.json",
  "title": "W0-DEF v0.6.9 Smart Medley evidence record",
  "description": "Complete W0-DEF record shape. Timing-only rows explicitly mark every unmeasured fixture, listening, memory, dropout, annotation, pair and capture field as not_applicable; they do not close W0-F or W2-C.",
  "type": "object",
  "required": [
    "protocolVersion", "runId", "timestampUtc", "timestampUnixMillis", "testKind", "trialId", "transitionId", "sequence", "order", "randomizationSeed",
    "analyzerVersion", "analyzerBuildSha256", "executableSha256", "host",
    "inputSha256", "dropoutSignalSha256", "fixtureManifestSha256", "labelManifestSha256", "captureSha256",
    "inputCodec", "inputSampleRateHz", "inputChannels", "inputDurationSeconds",
    "cacheState", "cacheKey", "osFileCacheCondition", "invalidationReason", "persistentReadPath",
    "monotonicStartNs", "monotonicEndNs", "elapsedMs", "status", "error", "persistedResultSha256",
    "bpmEstimate", "bpmConfidence", "keyEstimate", "keyConfidence", "cueInSeconds", "cueOutSeconds", "cueConfidence",
    "tempoCompatibility", "keyCompatibility", "cuePhaseCompatibility", "confidenceFloor", "compatibilityScore", "eligible", "expectedEligibility", "expectedStratum", "fallbackReason", "analysisAvailability",
    "memoryBaselineBytes", "memoryWorkloadPeakBytes", "memoryIncrementBytes", "samplerStartMonotonicNs", "samplerStopMonotonicNs", "lastScheduledSampleMonotonicNs", "memorySamples", "signalLoopCount", "signalLoopBoundaryMonotonicNs", "processPidParentSet",
    "outputEndpoint", "outputFormat", "wasapiCaptureFormat", "alignerVersion", "alignerBuildSha256", "anchorOffsets", "anchorCorrelations", "driftFit", "controlCaptureSha256", "concurrentCaptureSha256", "referenceRmsByChannel", "outputRmsByChannel", "underrunCounters", "dropoutEvents",
    "rawAnnotationValues", "consolidatedAnnotationValues", "bpmDeltas", "bpmConsensus", "roundingMethod", "cueIntervals", "cueIntersections", "adjudicationReason", "adjudicationResult", "referenceQ",
    "listenerIds", "listenerRatings", "artifactFlags", "listenerNotes",
    "fixtureStatus", "listeningStatus", "memoryStatus", "dropoutStatus"
  ],
  "properties": {
    "protocolVersion": { "const": "W0-DEF-v0.6.9" },
    "runId": { "type": "string", "minLength": 1 },
    "timestampUtc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "timestampUnixMillis": { "type": "integer", "minimum": 0 },
    "testKind": { "enum": ["cold-analysis", "cached-lookup", "timing-summary"] },
    "trialId": { "type": "string", "minLength": 1 },
    "transitionId": { "const": "not_applicable" },
    "sequence": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "not_applicable" }] },
    "order": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "not_applicable" }] },
    "randomizationSeed": { "const": "not_applicable" },
    "analyzerVersion": { "type": "string", "minLength": 1 },
    "analyzerBuildSha256": { "$ref": "#/$defs/sha256" },
    "executableSha256": { "$ref": "#/$defs/sha256" },
    "host": {
      "type": "object",
      "required": [
        "acceptedProfile", "osCaption", "edition", "editionId", "displayVersion", "servicingChannel", "buildFamily", "build", "ubr", "architecture",
        "cpuModel", "cpuCoreCount", "installedMemoryBytes", "installedKBs", "installedKBUpdateDates", "latestInstalledHotfix", "latestInstalledUpdateUtc",
        "minimumBaselineKB", "minimumBaselineUpdateDate", "minimumBaselineKBInstalled", "baselineProfileReviewedOn", "baselineProfileReviewCurrent", "baselineSources",
        "powerMode", "outputEndpoint", "hardwareProfileMethod"
      ],
      "properties": {
        "acceptedProfile": { "const": true },
        "osCaption": { "type": "string", "pattern": "Windows 11" },
        "edition": { "enum": ["Home", "Pro"] },
        "editionId": { "enum": ["Core", "Professional"] },
        "displayVersion": { "const": "26H2" },
        "servicingChannel": { "const": "General Availability Channel" },
        "buildFamily": { "const": 26300 },
        "build": { "type": "string", "pattern": "^26300\\.[0-9]+$" },
        "ubr": { "type": "integer", "minimum": 9711 },
        "architecture": { "const": "AMD64" },
        "cpuModel": { "type": "string", "minLength": 1 },
        "cpuCoreCount": { "const": 4 },
        "installedMemoryBytes": { "type": "integer", "minimum": 8589934592, "maximum": 9663676415 },
        "installedKBs": { "type": "array", "items": { "type": "string", "pattern": "^KB[0-9]+$" } },
        "installedKBUpdateDates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kb", "installedOnUtc"],
            "properties": { "kb": { "type": "string", "pattern": "^KB[0-9]+$" }, "installedOnUtc": { "type": "string", "format": "date-time" } },
            "additionalProperties": false
          }
        },
        "latestInstalledHotfix": { "type": ["string", "null"] },
        "latestInstalledUpdateUtc": { "type": "string", "format": "date-time" },
        "minimumBaselineKB": { "const": "KB5127648" },
        "minimumBaselineUpdateDate": { "const": "2026-10-13" },
        "minimumBaselineKBInstalled": { "type": "boolean" },
        "baselineProfileReviewedOn": { "const": "2026-10-20" },
        "baselineProfileReviewCurrent": { "const": true },
        "baselineSources": {
          "const": [
            "https://learn.microsoft.com/en-us/windows/release-health/status-windows-11-26h2/",
            "https://support.microsoft.com/en-us/servicing/os/windows-11/2026/10/kb5127648-windows-11-24h2-25h2-26h2-security-update"
          ]
        },
        "powerMode": { "type": "string" },
        "outputEndpoint": { "const": "not_applicable" },
        "hardwareProfileMethod": { "type": "string" }
      },
      "additionalProperties": false
    },
    "inputSha256": { "$ref": "#/$defs/sha256" },
    "dropoutSignalSha256": { "const": "not_applicable" },
    "fixtureManifestSha256": { "const": "not_applicable" },
    "labelManifestSha256": { "const": "not_applicable" },
    "captureSha256": { "const": "not_applicable" },
    "inputCodec": { "const": "pcm-s16le" },
    "inputSampleRateHz": { "const": 44100 },
    "inputChannels": { "const": 2 },
    "inputDurationSeconds": { "const": 180 },
    "cacheState": { "enum": ["miss-then-analysis", "clear-failed", "persistent-hit-no-decode", "miss-or-invalid", "not_applicable"] },
    "cacheKey": { "type": "string", "pattern": "^smart_medley_cache:smart-medley-0\\.1\\.0:[a-f0-9]{64}$" },
    "osFileCacheCondition": { "const": "uncontrolled-not-flushed" },
    "invalidationReason": { "type": "string", "minLength": 1 },
    "persistentReadPath": { "enum": ["GenesisBlockDB:lalin_play.settings", "not_applicable"] },
    "monotonicStartNs": { "type": "integer", "minimum": 0 },
    "monotonicEndNs": { "type": "integer", "minimum": 0 },
    "elapsedMs": { "type": "number", "minimum": 0 },
    "status": { "enum": ["PASS", "FAIL"] },
    "error": { "type": "string", "minLength": 1 },
    "persistedResultSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "const": "not_applicable" }] },
    "bpmEstimate": { "$ref": "#/$defs/numberOrNA" },
    "bpmConfidence": { "$ref": "#/$defs/numberOrNA" },
    "keyEstimate": { "oneOf": [{ "type": "object", "required": ["tonicSemitone", "mode"], "properties": { "tonicSemitone": { "type": "integer", "minimum": 0, "maximum": 11 }, "mode": { "enum": ["major", "minor"] } }, "additionalProperties": false }, { "const": "not_applicable" }] },
    "keyConfidence": { "$ref": "#/$defs/numberOrNA" },
    "cueInSeconds": { "$ref": "#/$defs/numberOrNA" },
    "cueOutSeconds": { "$ref": "#/$defs/numberOrNA" },
    "cueConfidence": { "$ref": "#/$defs/numberOrNA" },
    "tempoCompatibility": { "$ref": "#/$defs/numberOrNA" },
    "keyCompatibility": { "$ref": "#/$defs/numberOrNA" },
    "cuePhaseCompatibility": { "$ref": "#/$defs/numberOrNA" },
    "confidenceFloor": { "$ref": "#/$defs/numberOrNA" },
    "compatibilityScore": { "$ref": "#/$defs/numberOrNA" },
    "eligible": { "$ref": "#/$defs/boolOrNA" },
    "expectedEligibility": { "$ref": "#/$defs/boolOrNA" },
    "expectedStratum": { "type": "string" },
    "fallbackReason": { "type": "string" },
    "analysisAvailability": { "enum": ["ready", "low-confidence", "unsupported", "unreadable", "not_applicable"] },
    "memoryBaselineBytes": { "const": "not_applicable" },
    "memoryWorkloadPeakBytes": { "const": "not_applicable" },
    "memoryIncrementBytes": { "const": "not_applicable" },
    "samplerStartMonotonicNs": { "const": "not_applicable" },
    "samplerStopMonotonicNs": { "const": "not_applicable" },
    "lastScheduledSampleMonotonicNs": { "const": "not_applicable" },
    "memorySamples": { "const": "not_applicable" },
    "signalLoopCount": { "const": "not_applicable" },
    "signalLoopBoundaryMonotonicNs": { "const": "not_applicable" },
    "processPidParentSet": { "const": "not_applicable" },
    "outputEndpoint": { "const": "not_applicable" },
    "outputFormat": { "const": "not_applicable" },
    "wasapiCaptureFormat": { "const": "not_applicable" },
    "alignerVersion": { "const": "not_applicable" },
    "alignerBuildSha256": { "const": "not_applicable" },
    "anchorOffsets": { "const": "not_applicable" },
    "anchorCorrelations": { "const": "not_applicable" },
    "driftFit": { "const": "not_applicable" },
    "controlCaptureSha256": { "const": "not_applicable" },
    "concurrentCaptureSha256": { "const": "not_applicable" },
    "referenceRmsByChannel": { "const": "not_applicable" },
    "outputRmsByChannel": { "const": "not_applicable" },
    "underrunCounters": { "const": "not_applicable" },
    "dropoutEvents": { "const": "not_applicable" },
    "rawAnnotationValues": { "const": "not_applicable" },
    "consolidatedAnnotationValues": { "const": "not_applicable" },
    "bpmDeltas": { "const": "not_applicable" },
    "bpmConsensus": { "const": "not_applicable" },
    "roundingMethod": { "const": "not_applicable" },
    "cueIntervals": { "const": "not_applicable" },
    "cueIntersections": { "const": "not_applicable" },
    "adjudicationReason": { "const": "not_applicable" },
    "adjudicationResult": { "const": "not_applicable" },
    "referenceQ": { "const": "not_applicable" },
    "listenerIds": { "const": "not_applicable" },
    "listenerRatings": { "const": "not_applicable" },
    "artifactFlags": { "const": "not_applicable" },
    "listenerNotes": { "const": "not_applicable" },
    "fixtureStatus": { "const": "NOT_RUN" },
    "listeningStatus": { "const": "NOT_RUN" },
    "memoryStatus": { "const": "NOT_RUN: timing harness does not sample the app process tree" },
    "dropoutStatus": { "const": "NOT_RUN: timing harness does not capture WASAPI loopback or underrun counters" },
    "coldSampleCount": { "type": "integer", "minimum": 0 },
    "coldFailures": { "type": "integer", "minimum": 0 },
    "coldP95RankOneBased": { "type": "integer", "minimum": 1 },
    "coldP95Ms": { "type": "number", "minimum": 0 },
    "coldMedianMs": { "type": "number", "minimum": 0 },
    "coldMaximumMs": { "type": "number", "minimum": 0 },
    "coldTargetMs": { "const": 15000 },
    "coldStatus": { "enum": ["PASS", "FAIL"] },
    "cachedSampleCount": { "type": "integer", "minimum": 0 },
    "cachedFailures": { "type": "integer", "minimum": 0 },
    "cachedP95RankOneBased": { "type": "integer", "minimum": 1 },
    "cachedP95Ms": { "type": "number", "minimum": 0 },
    "cachedMedianMs": { "type": "number", "minimum": 0 },
    "cachedMaximumMs": { "type": "number", "minimum": 0 },
    "cachedTargetMs": { "const": 100 },
    "cachedStatus": { "enum": ["PASS", "FAIL"] },
    "fullW0FAcceptance": { "type": "string", "pattern": "^NOT_RUN:" }
  },
  "allOf": [
    {
      "if": { "properties": { "testKind": { "enum": ["cold-analysis", "cached-lookup"] } } },
      "then": { "required": ["sequence", "order", "cacheState", "invalidationReason", "persistentReadPath", "monotonicStartNs", "monotonicEndNs", "elapsedMs", "error", "persistedResultSha256"] }
    },
    {
      "if": { "properties": { "testKind": { "const": "timing-summary" } } },
      "then": { "required": [
        "coldSampleCount", "coldFailures", "coldP95RankOneBased", "coldP95Ms", "coldMedianMs", "coldMaximumMs", "coldTargetMs", "coldStatus",
        "cachedSampleCount", "cachedFailures", "cachedP95RankOneBased", "cachedP95Ms", "cachedMedianMs", "cachedMaximumMs", "cachedTargetMs", "cachedStatus", "fullW0FAcceptance"
      ] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "numberOrNA": { "oneOf": [{ "type": "number" }, { "const": "not_applicable" }] },
    "boolOrNA": { "oneOf": [{ "type": "boolean" }, { "const": "not_applicable" }] }
  }
}
