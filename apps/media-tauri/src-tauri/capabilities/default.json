{
  "identifier": "media-default",
  "description": "สิทธิ์พื้นฐานของ Lalin Media WebView และ DIAL response bridge",
  "windows": ["media"],
  "remote": {
    "urls": ["https://www.youtube.com/*"]
  },
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-dial-respond",
    "allow-dial-set-device-id"
  ]
}
