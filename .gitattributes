# Files that the Tauri CLI rewrites with LF on every `tauri dev` / `tauri build`.
# Keeping them LF in the working tree stops core.autocrlf=true from showing them
# as modified after each build.
apps/play-desktop/src-tauri/Cargo.toml text eol=lf
apps/play-desktop/src-tauri/permissions/autogenerated/** text eol=lf
